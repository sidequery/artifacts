{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "dev": {
    "ip": "127.0.0.1",
    "port": 4785
  },
  "build": {
    "command": "bun run scripts/prepare-cloudflare.ts",
    "watch_dir": [
      "src/sdk",
      "src/runtime",
      "src/gallery",
      "src/auth"
    ]
  },
  "assets": {
    "directory": "./dist/cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIBRARIES",
        "class_name": "CanvasLibrary"
      },
      {
        "name": "BACKENDS",
        "class_name": "CanvasBackend"
      },
      {
        "name": "LINKS",
        "class_name": "ArtifactLinks"
      },
      {
        "name": "SCRIPTS",
        "class_name": "ScriptLibrary"
      },
      {
        "name": "SCRIPT_BACKENDS",
        "class_name": "ScriptBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CanvasLibrary"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "CanvasBackend"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "ArtifactLinks",
        "ScriptLibrary",
        "ScriptBackend"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "limits": {
    "cpu_ms": 30000
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}
