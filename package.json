{
  "name": "canvas",
  "description": "Sidequery Canvas: React artifacts with a web gallery, version history, CLI, MCP, and optional Herdr integration.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "canvas": "src/cli.ts"
  },
  "scripts": {
    "canvas": "bun run src/cli.ts",
    "mcp": "bun run src/cli.ts mcp",
    "test": "bun test src --timeout 30000",
    "test:e2e": "bun test e2e/herdr.e2e.test.ts",
    "test:mcp-ui": "bun test e2e/mcp-app.test.ts --timeout 30000",
    "typecheck": "tsc --noEmit",
    "dev:cloudflare": "wrangler dev --local --var ENVIRONMENT:local",
    "prepare:celld": "bun run scripts/prepare-celld.ts",
    "dev:celld": "bun run build:cloudflare && bun run prepare:celld && bun run scripts/dev-celld.ts",
    "build:cloudflare": "wrangler deploy --dry-run --outdir dist/worker-app",
    "build:cloudflare-compiler": "wrangler deploy --config cloudflare/wrangler.compiler.jsonc --dry-run --outdir ../dist/worker",
    "typecheck:cloudflare": "tsc -p cloudflare/tsconfig.json --noEmit",
    "test:cloudflare": "bun run build:cloudflare-compiler && bun run build:cloudflare && bun test cloudflare --timeout 60000",
    "test:celld": "bun run build:cloudflare && bun run prepare:celld && CELLD_INTEGRATION=1 CELLD_AUTH_INTEGRATION=1 bun test cloudflare/celld.test.ts cloudflare/auth-flow.test.ts --timeout 180000",
    "deploy:cloudflare": "wrangler deploy",
    "seed:cloudflare": "bun run scripts/seed-cloudflare.ts"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.3",
    "@better-auth/oauth-provider": "1.7.3",
    "@cloudflare/worker-bundler": "0.2.3",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "8.20.0",
    "better-auth": "1.7.3",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@types/bun": "^1.3.14",
    "miniflare": "5.20260903.0-alpha",
    "playwright": "^1.63.0",
    "wrangler": "4.129.0"
  },
  "patchedDependencies": {
    "@cloudflare/worker-bundler@0.2.3": "patches/@cloudflare%2Fworker-bundler@0.2.3.patch"
  }
}
