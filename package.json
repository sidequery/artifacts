{
  "name": "canvas",
  "description": "Local React artifacts with a web gallery, version history, CLI, MCP, and Herdr integration.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "canvas": "src/cli.ts"
  },
  "scripts": {
    "canvas": "bun run src/cli.ts",
    "mcp": "bun run src/cli.ts mcp",
    "test": "bun test src --timeout 30000",
    "test:e2e": "bun test e2e/herdr.e2e.test.ts",
    "test:mcp-ui": "bun test e2e/mcp-app.test.ts --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright": "^1.63.0"
  }
}
