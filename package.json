{
  "name": "@sidequery/artifacts",
  "description": "Sidequery Artifacts: React artifacts with a web gallery, version history, CLI, MCP, and optional Herdr integration.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidequery/artifacts.git"
  },
  "homepage": "https://github.com/sidequery/artifacts#readme",
  "bugs": {
    "url": "https://github.com/sidequery/artifacts/issues"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": "./src/sdk/index.ts",
    "./plugins": "./src/plugins/config.ts"
  },
  "bin": {
    "artifacts": "src/cli.ts"
  },
  "files": [
    "dist/celld/**",
    "dist/cloudflare/**",
    "dist/worker-app/**",
    "docs/architecture.md",
    "docs/daemon.md",
    "docs/celld-deployment.md",
    "docs/releasing.md",
    "docs/scripts.md",
    "docs/runtime-plugins.md",
    "docs/routing.md",
    "docs/files.md",
    "src/args.ts",
    "src/auth/client-api.ts",
    "src/auth/client.tsx",
    "src/auth/server.ts",
    "src/artifactFile.ts",
    "src/cli.ts",
    "src/compile.ts",
    "src/diagnostics.ts",
    "src/gallery/client.tsx",
    "src/gallery/hosted.tsx",
    "src/gallery/remix.tsx",
    "src/gallery/server.ts",
    "src/gallery/types.ts",
    "src/herdr.ts",
    "src/history.ts",
    "src/historyTypes.ts",
    "src/html.ts",
    "src/httpTypes.ts",
    "src/local/celld-runtime.ts",
    "src/local/preview-daemon.ts",
    "src/local/server-daemon.ts",
    "src/local/server.ts",
    "src/mcp/app-contract.ts",
    "src/mcp/app.ts",
    "src/mcp/guide.ts",
    "src/mcp/local-tools.ts",
    "src/mcp/protocol.ts",
    "src/mcp/stdio.ts",
    "src/mcp/tools.ts",
    "src/open.ts",
    "src/paths.ts",
    "src/plugins/browser.ts",
    "src/plugins/config.ts",
    "src/plugins/types.ts",
    "src/runtime/cloud-runtime.ts",
    "src/runtime/gallery-request.ts",
    "src/runtime/artifacts-entry.d.ts",
    "src/runtime/mcp-app.ts",
    "src/runtime/navigation-host.ts",
    "src/runtime/wrapper.tsx",
    "src/sandbox.ts",
    "src/sdk/charts.tsx",
    "src/sdk/forms.tsx",
    "src/sdk/files.ts",
    "src/sdk/hooks.ts",
    "src/sdk/index.ts",
    "src/sdk/plugins.ts",
    "src/sdk/routing.tsx",
    "src/sdk/server.ts",
    "src/sdk/tokens.ts",
    "src/sdk/ui.tsx",
    "src/serve.ts",
    "src/service.ts",
    "src/typecheck.ts",
    "src/viewer.ts",
    "src/localProject.ts",
    "cloudflare/project.ts",
    "src/gallery/execution-controls.tsx",
    "src/gallery/project-editor.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "mcp": "bun run src/cli.ts mcp",
    "test": "bun test src scripts/prepare-plugins.test.ts examples/runner-status --timeout 30000",
    "test:e2e": "bun test e2e/herdr.e2e.test.ts",
    "test:mcp-ui": "bun test e2e/mcp-app.test.ts e2e/gallery-scripts.test.ts e2e/execution-controls.test.ts e2e/browser-plugins.test.ts e2e/plugin-bridge.test.ts e2e/routing.test.ts e2e/runner-status.test.ts --timeout 30000",
    "typecheck": "tsc --noEmit && tsc -p examples/runner-status/tsconfig.json --noEmit && tsc -p examples/runner-status/tsconfig.local.json --noEmit",
    "dev:cloudflare": "wrangler dev --local --var ENVIRONMENT:local",
    "prepare:celld": "bun run scripts/prepare-celld.ts",
    "build:package": "bun run scripts/build-package.ts",
    "prepack": "bun run build:package",
    "test:package": "bun run build:package && bun test scripts/package.integration.test.ts --timeout 360000",
    "test:package:prebuilt": "bun run scripts/build-package.ts --prebuilt-worker && bun test scripts/package.integration.test.ts --timeout 360000",
    "dev:celld": "bun run build:cloudflare && bun run prepare:celld && bun run scripts/dev-celld.ts",
    "build:cloudflare": "wrangler deploy --dry-run --outdir dist/worker-app",
    "build:cloudflare-compiler": "wrangler deploy --config cloudflare/wrangler.compiler.jsonc --dry-run --outdir ../dist/worker",
    "typecheck:cloudflare": "tsc -p cloudflare/tsconfig.json --noEmit && tsc -p examples/runner-status/tsconfig.worker.json --noEmit",
    "test:cloudflare": "bun run build:cloudflare-compiler && bun run build:cloudflare && bun test cloudflare --timeout 60000",
    "test:celld": "bun run build:cloudflare && bun run prepare:celld && CELLD_INTEGRATION=1 CELLD_AUTH_INTEGRATION=1 CELLD_BACKEND_INTEGRATION=1 bun test cloudflare/backend.test.ts cloudflare/celld.test.ts cloudflare/auth-flow.test.ts --timeout 180000",
    "deploy:cloudflare": "wrangler deploy",
    "seed:cloudflare": "bun run scripts/seed-cloudflare.ts",
    "example:runner-status": "bun run examples/runner-status/local.ts",
    "artifacts": "bun run src/cli.ts",
    "build:executable": "bun run scripts/build-executable.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.3",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "better-auth": "1.7.3",
    "cron-parser": "5.10.0",
    "esbuild": "0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7",
    "semver": "7.7.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@better-auth/mcp": "1.7.3",
    "@cloudflare/worker-bundler": "0.2.3",
    "@cloudflare/workers-types": "5.20260907.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bun": "^1.3.14",
    "@types/semver": "7.7.1",
    "ajv": "8.20.0",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "miniflare": "5.20260903.0-alpha",
    "playwright": "^1.63.0",
    "wrangler": "4.129.0"
  },
  "patchedDependencies": {
    "@cloudflare/worker-bundler@0.2.3": "patches/@cloudflare%2Fworker-bundler@0.2.3.patch"
  }
}
